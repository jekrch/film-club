# On-site editing (docs/film-lists-plan.md §8). Both are optional and both are
# public: without them the site builds and runs exactly as it does otherwise,
# minus the editing surfaces — no sign-in button, no rating editor, no list
# editor. Copy this file to `.env.local` to develop against a deployed worker.

# The OAuth *web client* ID from the Google Cloud console. The same value goes
# in worker/wrangler.toml, which is what every ID token's `aud` is checked
# against. Public by design in the ID-token flow.
VITE_GOOGLE_CLIENT_ID=

# Base URL of the editing worker.
VITE_EDITOR_API_URL=
