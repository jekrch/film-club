{
    "name": "film-club",
    "private": true,
    "homepage": "https://www.criterionclub.org",
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predeploy": "bun run build",
        "deploy": "gh-pages -d dist",
        "dev": "bun vite --port 5173",
        "build": "tsc -b && bun vite build",
        "lint": "bun eslint .",
        "typecheck": "tsc -b",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "bun vite preview",
        "test": "bun jest",
        "test:coverage": "bun jest --coverage --maxWorkers=2"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.3",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/merriweather": "^5.3.0",
        "@heroicons/react": "^2.2.0",
        "@jekrch/react-viewport-lightbox": "^0.10.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@tailwindcss/vite": "^4.3.5",
        "@types/jest": "^29.5.14",
        "@xyflow/react": "^12.12.1",
        "baseline-browser-mapping": "^2.11.37",
        "caniuse-lite": "^1.0.30001826",
        "classnames": "^2.5.1",
        "framer-motion": "^12.43.0",
        "hamburger-react": "^2.5.2",
        "highcharts": "^12.6.2",
        "highcharts-react-official": "^3.2.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.5",
        "remark-breaks": "^4.0.0",
        "swiper": "^14.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.3",
        "@types/dagre": "^0.7.54",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.6.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "gh-pages": "^6.3.0",
        "globals": "^16.5.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "postcss": "^8.5.33",
        "prettier": "~3.8.5",
        "tailwindcss": "^4.3.5",
        "ts-jest": "^29.4.15",
        "typescript": "~5.7.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^6.4.6",
        "vite-plugin-pwa": "^1.3.0"
